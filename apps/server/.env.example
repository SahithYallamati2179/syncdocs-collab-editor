PORT=1234

# dev      -> no sign-in; trust the identity the browser sends (zero setup)
# supabase -> require a Google sign-in via Supabase and enforce document access
AUTH_MODE=dev

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
# Needed for AUTH_MODE=supabase (used to fetch the JWKS for token verification).
SUPABASE_URL=

# Only needed if your Supabase project still signs tokens with the legacy
# HS256 shared secret. Projects using asymmetric keys need SUPABASE_URL only.
SUPABASE_JWT_SECRET=

STORAGE_DRIVER=file
DATA_DIR=./.data
DATABASE_URL=

PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_DEBOUNCE_MS=10000
SNAPSHOT_INTERVAL_MS=300000

CORS_ORIGIN=*
