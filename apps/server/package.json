{
  "name": "@collab/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hocuspocus-based Yjs sync relay with pluggable persistence.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
