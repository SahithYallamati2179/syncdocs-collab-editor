# ---------------------------------------------------------------------------
# Copy to apps/server/.env and apps/web/.env.local. Every value below has a
# working default, so the project runs with NO configuration at all.
# ---------------------------------------------------------------------------

# --- Sync server (apps/server/.env) ----------------------------------------
PORT=1234

# dev      -> no sign-in; trust the identity the browser sends (zero setup)
# supabase -> require Google sign-in and enforce per-document access
AUTH_MODE=dev
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# file     -> persist Y.Doc binaries to ./apps/server/.data (zero config)
# postgres -> persist to Postgres (requires DATABASE_URL + sql/schema.sql)
STORAGE_DRIVER=file
DATA_DIR=./.data
DATABASE_URL=

PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_DEBOUNCE_MS=10000
SNAPSHOT_INTERVAL_MS=300000
CORS_ORIGIN=*

# --- Web app (apps/web/.env.local) -----------------------------------------
NEXT_PUBLIC_COLLAB_WS_URL=ws://127.0.0.1:1234
NEXT_PUBLIC_COLLAB_HTTP_URL=http://127.0.0.1:1234
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
